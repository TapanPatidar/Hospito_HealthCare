# MongoDB Connection String (Atlas or local)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/hospito?retryWrites=true&w=majority"

# JWT Secret for authenticating sessions
JWT_SECRET="hospito_secure_jwt_secret_key_2025"

# Server Port (AI Studio container routes through port 3000)
PORT="3000"

# GEMINI_API_KEY: Required for Gemini AI features if needed
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""
